<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo manifest (https://gerrit.googlesource.com/git-repo) - lists every
  router-providing repo this deployment can pull in. tools/sync-routers.sh
  runs `repo init -u <this repo> -m manifest/default.xml` followed by
  `repo sync` to fetch/pin them into the `path` given below, ready for
  main.py's dynamic loader (see routers.yaml) to import.

  A deploy step overrides a project's revision without editing this file
  by dropping a repo local manifest into .repo/local_manifests/ before
  syncing - see .github/actions/sync-routers's revision-overrides input.
-->
<manifest>
  <remote name="dash-xd" fetch="https://github.com/dash-xd/" />
  <default remote="dash-xd" revision="main" sync-j="4" />

  <project name="gcp-python-function-inspector" path="routers/gcp-python-function-inspector" />
</manifest>
